# Tmap open API app key (https://openapi.sk.com)
TMAP_APP_KEY=your-tmap-app-key

# Seoul open data portal key (https://data.seoul.go.kr)
SEOUL_API_KEY=your-seoul-api-key

# Reitti instance
REITTI_URL=https://reitti.example.com
REITTI_TOKEN=your-reitti-api-token

# Optional tuning
POLL_INTERVAL_SECONDS=15
LOG_LEVEL=INFO
STATIONS_CSV=data/stations.csv
DB_PATH=data/tracker.db

# Optional local Grafana login for docker compose
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
