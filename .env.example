# Tmap open API app key (https://openapi.sk.com)
TMAP_APP_KEY=your-tmap-app-key

# Self-hosted subway realtime API sidecar (~/Documents/subway)
SUBWAY_API_URL=http://subway-api:8000

# Reitti instance
REITTI_URL=https://reitti.example.com
REITTI_TOKEN=your-reitti-api-token

# Optional tuning
POLL_INTERVAL_SECONDS=5
LOG_LEVEL=INFO
STATIONS_CSV=data/stations.csv
DB_PATH=data/tracker.db

# Optional OpenTelemetry export for a native `uv run` server. Docker Compose
# defaults to http://host.docker.internal:4318 so it can use the shared LGTM.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=subway-tracker
OTEL_EXPORT_TIMEOUT_SECONDS=5
OTEL_METRIC_EXPORT_INTERVAL_MILLIS=10000
